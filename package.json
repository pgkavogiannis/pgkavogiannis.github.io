        "clsx": "^2.1.1",
        "daisyui": "^5.4.4",
        "next": "16.0.1",
        "react": "19.2.0",
        "react-dom": "19.2.0"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "4.1.16",
        "@tailwindcss/typography": "0.5.19",
        "@types/node": "24.10.0",
        "@types/react": "19.2.2",
        "@types/react-dom": "19.2.2",
        "autoprefixer": "^10.4.21",
        "eslint": "9.39.1",
        "eslint-config-next": "16.0.1",
        "husky": "^9.1.7",
        "lint-staged": "15",
        "postcss": "^8.5.6",
        "prettier": "^3.8.3",
        "sass": "^1.93.3",
